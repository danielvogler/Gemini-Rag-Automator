GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=your-google-cloud-location
GCS_BUCKET_NAME=your-gcs-bucket-name
RAG_CORPUS_DISPLAY_NAME="Your-RAG-Corpus-Display-Name"
RAG_CORPUS_DESCRIPTION="Your RAG Corpus Description"
GCP_SECRET_ID="YOUR_GCP_SECRET_ID"
GEMINI_MODEL_NAME="gemini-2.5-flash"
SERVICE_ACCOUNT_ID=your-rag-ingestor-sa
CLOUD_FUNCTION_NAME=your-rag-ingestor-function

# --- Vertex AI Agent Engine (corpus-only ADK agent) ---
# Region for Agent Engine deployment. For simplicity, set this to the SAME region
# as GOOGLE_CLOUD_LOCATION above. Co-locating avoids cross-region latency and
# ensures the model the agent uses is available in that region. Recommended:
# europe-west1, europe-west4, us-central1 (all support Gemini 2.5 Flash and
# Vertex AI RAG Engine). Note: europe-west6 hosts RAG corpora but does NOT serve
# Gemini, so cannot host this agent.
AGENT_ENGINE_LOCATION=europe-west1
# Model the agent uses to synthesise answers from retrieved chunks.
# gemini-2.5-flash is recommended: highly controllable, available across most
# Vertex AI regions, and our defense-in-depth stack (function-tool retrieval,
# Layer 6 validator) works best with it. Gemini 3 models are typically not yet
# generally available in 2026 and are not needed here - the leak the user
# observed in Gemini 3's dynamic grounding is architecturally avoided by this
# agent's design.
AGENT_MODEL_NAME=gemini-2.5-flash
# Display name used to discover/update the deployed agent on Agent Engine.
AGENT_DISPLAY_NAME=gra-corpus-agent
# GCS bucket Agent Engine uses for code packaging during deploy. Provisioned by Terraform.
AGENT_STAGING_BUCKET_NAME=your-agent-staging-bucket-name
# Filled in automatically by scripts/deploy_agent.py after a successful deploy.
AGENT_ENGINE_ID=
# Set to 1 to enable structured-output (JSON) responses; 0 for plain text + [n]
# citations followed by a "Source excerpts:" section. Either way the excerpts
# are emitted by the agent itself, so they also appear in the Agent Engine UI.
AGENT_STRUCTURED_OUTPUT=0
# Max characters of each retrieved chunk shown under "Source excerpts:".
# Set to 0 to disable truncation (show the full chunk text). Default: 600.
AGENT_EXCERPT_MAX_CHARS=600
# Optional: full corpus resource path. If set, the deploy script uses it directly
# and skips Secret Manager. Useful when your corpus lives outside the terraform-
# managed setup. Format: projects/<PROJECT>/locations/<REGION>/ragCorpora/<ID>
RAG_CORPUS=
